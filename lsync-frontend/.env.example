# Demo mode: serves sample data from the browser, no backend needed.
# Set to false to use the real API at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the LSync backend API (no trailing slash). Only used when demo mode is off.
# Local backend from the handoff doc:
NEXT_PUBLIC_API_URL=http://localhost:2005

# Never put API keys or secrets in NEXT_PUBLIC_* variables: they are shipped to every browser.
